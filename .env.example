# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled-in file.
#
# The browser only ever receives the two VITE_* Supabase values. Everything
# else is read by Node maintenance scripts or set as an edge-function secret,
# so the anon key is the only credential that reaches a client.
# ---------------------------------------------------------------------------

# --- Client (exposed to the browser by Vite) -------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Enables the "preview as student" button in the Exam Builder by
# signing in as a dedicated throwaway student account. Leave blank to disable
# the button entirely rather than shipping a password in source.
VITE_PREVIEW_STUDENT_EMAIL=
VITE_PREVIEW_STUDENT_PASSWORD=

# --- Maintenance scripts (Node only, never bundled) ------------------------
# Scripts in scripts/ authenticate as an admin user and go through PostgREST
# with RLS enforced. Prefer this over the service role key.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Only needed for the few scripts that must bypass RLS (backups, hard deletes).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI generation (edge-function secret, not a client variable) ------------
# Set with: supabase secrets set ANTHROPIC_API_KEY=... ANTHROPIC_MODEL=...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
